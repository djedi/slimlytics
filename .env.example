# Application
SLIMLYTICS_BASE_URL=http://localhost:8080
RUST_LOG=slimlytics=info,tower_http=info
BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080

# For direct public TLS with compose.production.yaml, uncomment and set:
# SLIMLYTICS_DOMAIN=analytics.example.com
# ACME_EMAIL=admin@example.com

# Database
POSTGRES_DB=slimlytics
POSTGRES_USER=slimlytics
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Authentication and privacy
JWT_SECRET=replace-with-at-least-32-random-bytes
VISITOR_HASH_SECRET=replace-with-a-different-long-random-secret
ACCESS_TOKEN_TTL_SECONDS=3600
TRUST_PROXY=false
# Visitor locations come from trusted edge headers (TRUST_PROXY) or a local MMDB database.
# `make geoip` downloads the free DB-IP City Lite database (CC BY 4.0) to data/geoip/, which
# Compose mounts at the default path below. To use MaxMind GeoLite2/GeoIP2 instead, place the
# .mmdb in data/geoip/ and point this at /data/geoip/<file>.mmdb.
# GEOIP_DATABASE_PATH=/data/geoip/dbip-city-lite.mmdb

# Optional Google Search Console OAuth integration. Configure all four together.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=https://analytics.example.com/api/integrations/search-console/callback
# Generate 32 random bytes and base64 encode them. Rotating this disconnects stored integrations.
# INTEGRATION_ENCRYPTION_KEY=

# Optional hosted billing (plan limits + Stripe). Off by default: self-hosted installs are
# unlimited. See docs/BILLING.md. Set both Stripe values or neither.
# BILLING_ENABLED=false
# BILLING_PLANS_FILE=/config/plans.json
# STRIPE_SECRET_KEY=rk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Compose derives DATABASE_URL and the frontend ORIGIN from these values.

# Optional: copy one account from a remote deployment into local Docker for testing
# (scripts/sync-account.sh, `make sync-account`). Read-only on the remote side.
# SYNC_SOURCE_SSH=deploy@analytics.example.com
# SYNC_SOURCE_PATH=/srv/slimlytics
# SYNC_SOURCE_COMPOSE_FILES=compose.yaml compose.proxy.yaml
# SYNC_EMAIL=you@example.com
# SYNC_EVENT_DAYS=90
